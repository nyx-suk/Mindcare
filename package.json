{
  "main": "expo/AppEntry.js",
  "scripts": {
    "test": "jest --watchAll=false"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.(ts|tsx)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|expo-linear-gradient|react-native-keychain|react-redux|@reduxjs))"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ]
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-native": "^0.72.8",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.17",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/stack": "^7.8.10",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.16.0",
    "expo": "^55.0.23",
    "expo-linear-gradient": "~55.0.13",
    "expo-localization": "~55.0.13",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-chart-kit": "^6.12.2",
    "react-native-gesture-handler": "2.30.1",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3",
    "react-redux": "^9.2.0",
    "uvicorn": "^0.0.1-security"
  }
}
